# ---------------------------------------------------------------------------
# SnapBuy frontend configuration
# Copy to `.env` if you need to override the defaults. Only VITE_* variables
# reach the browser - NEVER put an API key here.
#
# The frontend calls the backend through relative `/api/*` URLs:
#   - dev:  Vite proxies /api to VITE_API_PROXY_TARGET
#   - prod: serve the built app behind a reverse proxy that forwards /api
# ---------------------------------------------------------------------------

# Where the Vite dev server proxies /api requests (default: http://127.0.0.1:8000)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Only change this if the API is served from a different origin than the app.
# Leave empty to use relative /api paths (recommended).
VITE_API_BASE_URL=
