# Copy to `.env` and fill in your keys. Never commit `.env`.

# SerpApi key — powers live shopping results. https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# AI vision (optional): openai | gemini | local — auto-detected from the key when empty.
VISION_PROVIDER=local
VISION_API_KEY=

# OWL-ViT object detection model (used for product type + attribute detection).
# IMPORTANT: This must be an OWL-ViT checkpoint — NOT a CLIP checkpoint.
# Default: google/owlvit-base-patch32 (smaller, faster, still accurate)
# Alternative: google/owlvit-large-patch14 (better accuracy, more VRAM)
LOCAL_VISION_MODEL=google/owlvit-base-patch32

# Optional: path to a pre-downloaded model directory.
# When set, no Hugging Face network request is made at startup.
# LOCAL_VISION_MODEL_DIR=./models/owlvit-base-patch32

# Cache-miss download attempts (1-3) and cooldown after a failed load.
LOCAL_VISION_LOAD_ATTEMPTS=2
LOCAL_VISION_RETRY_SECONDS=60

# CLIP reranking model — used ONLY for visual similarity scoring of search results.
# This is a different model from OWL-ViT above. Do not mix the two.
IMAGE_EMBEDDING_MODEL=openai/clip-vit-base-patch32

# Max product thumbnails to embed per search (more = slower but more accurate).
VISUAL_RERANK_MAX_IMAGES=12

# auto = demo data only when keys are missing | on = always demo | off = never demo
DEMO_MODE=auto
