# ---------------------------------------------------------------------------
# SnapBuy backend configuration
# Copy to `.env` and fill in the values you have. Never commit `.env`.
# ---------------------------------------------------------------------------

# SerpApi - powers every shopping result in the app.
# Get a key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here

# Market for Google Shopping results (India is the hackathon default).
SERPAPI_ENGINE=google_shopping
SERPAPI_GL=in
SERPAPI_HL=en
SERPAPI_LOCATION=India
SERPAPI_TIMEOUT_SECONDS=25
SERPAPI_MAX_RESULTS=40
# Retry with engine=google&tbm=shop when google_shopping returns nothing.
SERPAPI_FALLBACK_ENGINE=true
SEARCH_CACHE_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# AI vision - image recognition. Leave VISION_PROVIDER empty to auto-detect.
# provider = openai | gemini | demo
# ---------------------------------------------------------------------------
VISION_PROVIDER=
VISION_API_KEY=your_vision_api_key_here
# Optional model override. Leave empty to use the provider default.
# Model IDs are retired often, so the backend keeps a small fallback list and
# automatically retries the next candidate when a model itself is rejected.
#   openai defaults: gpt-5.2-mini -> gpt-5.2-chat-latest -> gpt-4o-mini
#   gemini defaults: gemini-3.8-flash -> gemini-2.5-flash -> gemini-flash-latest
VISION_MODEL=
# Optional custom gateway / proxy base URL
VISION_BASE_URL=
VISION_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# auto = use real APIs when configured, otherwise clearly-labelled demo data
# on   = always use demo data (hackathon safety net)
# off  = never use demo data (missing keys become real errors)
DEMO_MODE=auto
FRONTEND_URL=http://localhost:5173
# Extra CORS origins, comma separated
CORS_ORIGINS=

# Uploads
MAX_UPLOAD_MB=10
MAX_IMAGE_DIMENSION=1280
DEBUG=false
